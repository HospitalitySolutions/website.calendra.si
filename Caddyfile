:80 {
  root * /srv
  encode gzip zstd

  # Applied to every response. TLS is terminated in front of this container, so
  # Strict-Transport-Security is set here and only ever honoured by the browser
  # over HTTPS. No Content-Security-Policy yet: the prerendered pages carry
  # inline JSON-LD, and a policy loose enough to allow that buys little.
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
    X-Frame-Options "SAMEORIGIN"
    -Server
  }

  # Old public-booking links used ?tenant=<tenantCode>. Move those requests to
  # the canonical per-tenant booking path instead of serving the generic page
  # with only a canonical tag. Preserve locationId when the old link contains it.
  @legacyTenantBookingWithLocation {
    path /narocanje /stranke /booking /clients /en/booking /en/clients
    query tenant=* locationId=*
  }
  @legacyTenantBooking {
    path /narocanje /stranke /booking /clients /en/booking /en/clients
    query tenant=*
  }

  # Keep this redirect group literal. A plain path redirect such as /booking
  # would otherwise be sorted ahead of the more specific query-aware matcher.
  route {
    redir @legacyTenantBookingWithLocation /narocanje/{http.request.uri.query.tenant}?locationId={http.request.uri.query.locationId} 308
    redir @legacyTenantBooking /narocanje/{http.request.uri.query.tenant} 308

    # Older English per-business booking URLs used /en/booking/{tenantCode}.
    # The canonical public booking URL is language-neutral /narocanje/{tenantCode}.
    @legacyEnBookingPath path_regexp legacyEnBookingPath ^/en/booking/([^/]+)$
    redir @legacyEnBookingPath /narocanje/{re.legacyEnBookingPath.1} 308

    # While the marketplace is private, keep old directory landing URLs useful
    # instead of redirecting crawlers and visitors into intentionally disabled 404s.
    @privateLegacySlDirectory {
      path /ponudniki /podjetja /stranke
      expression `"{$CUSTOMER_MARKETPLACE_PUBLIC:false}" != "true"`
    }
    @privateLegacyEnDirectory {
      path /en/providers /en/businesses /en/clients /clients
      expression `"{$CUSTOMER_MARKETPLACE_PUBLIC:false}" != "true"`
    }
    redir @privateLegacySlDirectory /narocanje 308
    redir @privateLegacyEnDirectory /en/booking 308

    # This known historical profile has a direct-booking replacement. Keep the
    # redirect specific so unrelated old marketplace profiles are not sent to a
    # potentially non-equivalent booking URL.
    @legacyAvisensaProfile {
      path /ponudniki/institut-avisensa /podjetja/institut-avisensa /en/providers/institut-avisensa /en/businesses/institut-avisensa
      expression `"{$CUSTOMER_MARKETPLACE_PUBLIC:false}" != "true"`
    }
    redir @legacyAvisensaProfile /narocanje/institut-avisensa 308

    @legacySlProviderProfile path_regexp legacySlProviderProfile ^/(?:ponudniki|podjetja)/(.+)$
    @legacyEnProviderProfile path_regexp legacyEnProviderProfile ^/en/(?:providers|businesses)/(.+)$
    redir @legacySlProviderProfile /za-stranke/{re.legacySlProviderProfile.1} 308
    redir @legacyEnProviderProfile /en/for-customers/{re.legacyEnProviderProfile.1} 308

    # Canonical language-specific URLs. Legacy English aliases redirect to /en/*.
    redir /pricing /en/pricing 308
    redir /za-podjetja / 308
    redir /en/for-business /en 308
    redir /mobilna-aplikacija /calendra-connect 308
    redir /mobile-app /en/calendra-connect 308
    redir /en/mobile-app /en/calendra-connect 308
    redir /ponudniki /za-stranke 308
    redir /en/providers /en/for-customers 308
    redir /podjetja /za-stranke 308
    redir /en/businesses /en/for-customers 308
    redir /stranke /za-stranke 308
    redir /en/clients /en/for-customers 308
    redir /clients /en/for-customers 308
    redir /booking /en/booking 308
    redir /support /en/support 308
    redir /privacy-policy /en/privacy-policy 308
    redir /terms-of-service /en/terms-of-service 308
    redir /legal /en/legal 308
    redir /data-processing-agreement /en/data-processing-agreement 308
    redir /dpa /en/data-processing-agreement 308
    redir /subprocessors /en/subprocessors 308
    redir /cookie-policy /en/cookie-policy 308
    redir /cookies /en/cookie-policy 308
    redir /security /en/security 308
    redir /data-rights /en/data-rights 308
    redir /zoom /en/zoom-integration 308
    redir /zoom-integration /en/zoom-integration 308
    redir /ai-transparency /en/ai-transparency 308
    redir /account-deletion /en/account-deletion 308
  }

  # Keep the consumer marketplace private until launch. Build-time code uses
  # the same switch to remove navigation and sitemap entries. Direct booking
  # URLs under /narocanje/* remain public and are intentionally not matched.
  @privateMarketplace {
    path /za-stranke /za-stranke/* /en/for-customers /en/for-customers/*
    expression `"{$CUSTOMER_MARKETPLACE_PUBLIC:false}" != "true"`
  }
  respond @privateMarketplace 404

  # Cookieless analytics served first-party. Content blockers match on known
  # third-party analytics hostnames, so proxying the tracker and its collect
  # endpoint through our own domain is what keeps the data usable.
  handle /stats/* {
    reverse_proxy analytics:3000
  }

  # Vite fingerprints files in /assets, so they can be cached indefinitely.
  @immutableAssets path /assets/*
  header @immutableAssets Cache-Control "public, max-age=31536000, immutable"

  # Public images and icons use stable names and a shorter browser cache.
  @staticImages path /hero/* /reviews/* /og/* /favicon.ico /favicon-*.png /apple-touch-icon.png /icon-*.png /calendra-logo.png /calendra-wordmark.webp /og-calendra.png /connect/*
  header @staticImages Cache-Control "public, max-age=604800"

  # Font subsets are regenerated only when a family changes, and the filename
  # changes with it, so they can be cached for a year.
  @fonts path /fonts/*
  header @fonts Cache-Control "public, max-age=31536000, immutable"

  # Prerendered HTML references fingerprinted assets, so a stale copy would keep
  # pointing at a bundle that no longer exists. Left unset, browsers apply their
  # own heuristic freshness; this makes them revalidate against the ETag every
  # time, which is cheap because unchanged pages come back as 304.
  # Extensionless routes plus any .html file; anything with another extension is
  # a fingerprinted or long-lived asset already handled above.
  @documents path_regexp ^(/[^.]*|.*\.html)$
  header @documents Cache-Control "public, max-age=0, must-revalidate"

  # Crawler and AI-assistant entry points change on every deploy, and a stale
  # sitemap or llms.txt is worse than a slightly slower fetch.
  @crawlerFiles path /sitemap.xml /robots.txt /llms.txt /llms-full.txt
  header @crawlerFiles Cache-Control "public, max-age=3600"

  # Public location profiles are created from live directory data, so not every
  # /za-stranke/{locationCode} URL exists at build time. Prefer a real prerendered
  # profile when one exists; otherwise serve the matching language-specific
  # profile shell and let the client resolve the location code from the API.
  @slCustomerProfile path /za-stranke/*
  handle @slCustomerProfile {
    try_files {path}/index.html /_dynamic-location-profile-sl.html
    file_server
  }

  @enCustomerProfile path /en/for-customers/*
  handle @enCustomerProfile {
    try_files {path}/index.html /_dynamic-location-profile-en.html
    file_server
  }

  # Serve any route that was actually prerendered by the build. Unknown paths
  # remain unknown and are returned as 404 by file_server—there is no second
  # manually maintained route whitelist to drift out of sync.
  handle {
    try_files {path}/index.html {path}
    file_server
  }
}
