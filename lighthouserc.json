{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve-dist.mjs 4173",
      "startServerReadyPattern": "Serving dist on",
      "url": [
        "http://127.0.0.1:4173/",
        "http://127.0.0.1:4173/cenik",
        "http://127.0.0.1:4173/narocanje",
        "http://127.0.0.1:4173/blog",
        "http://127.0.0.1:4173/blog/kako-zmanjsati-pozabljene-termine"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "skipAudits": ["canonical", "is-crawlable", "uses-http2", "redirects-http"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2000 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 200 }],
        "unused-javascript": "off",
        "uses-long-cache-ttl": "off"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
