# Copy to `.env` on the deployment host and fill in. `.env` is gitignored.

# --- Site ---
VITE_SITE_URL=https://calendra.si
VITE_APP_BASE_URL=https://app.calendra.si

# --- Social profiles used for schema.org sameAs ---
VITE_LINKEDIN_URL=
VITE_YOUTUBE_URL=
VITE_GOOGLE_PLAY_URL=
VITE_APP_STORE_URL=

# --- Off-site entity profiles (schema.org sameAs) ---
# Comma or newline separated absolute URLs: Wikidata, Crunchbase, Product Hunt,
# G2, Capterra, bizi.si, and any other directory listing Calendra. Every listing
# must use the exact name, address and phone number in docs/entity-profiles.md,
# otherwise the listings describe two different businesses as far as a search
# engine is concerned. See that file for the checklist.
VITE_ENTITY_PROFILE_URLS=

# Personal profiles for the named author, e.g. a LinkedIn profile.
VITE_AUTHOR_PROFILE_URLS=

# Public registration identifiers, emitted in Organization schema when set.
# Wikidata id has the form Q123456 and is set once the item is created.
VITE_COMPANY_VAT_ID=
VITE_COMPANY_REGISTRATION_NUMBER=
VITE_WIKIDATA_ENTITY_ID=

# --- Cookieless analytics (self-hosted Umami) ---
# Leave VITE_UMAMI_WEBSITE_ID empty to build without any analytics at all.
# Get the id from the Umami dashboard at https://calendra.si/stats after the
# first `docker compose up`, then rebuild the website image.
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_SCRIPT_URL=/stats/script.js
VITE_UMAMI_HOST_URL=/stats

# Generate with: openssl rand -base64 32
UMAMI_APP_SECRET=
UMAMI_DB_PASSWORD=

# --- Search engine verification ---
# Prefer DNS TXT verification, which survives redeploys. These meta-tag
# fallbacks exist for the cases where DNS is not available.
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=

# --- IndexNow (instant Bing/Yandex indexing, which also feeds Copilot and ChatGPT search) ---
# Any 8-128 character hex string. Must match the filename served at /<key>.txt.
# Generate with: openssl rand -hex 16
INDEXNOW_KEY=
